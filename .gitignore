# Virtual environment (rebuild it with: pip install -r requirements.txt)
.venv/

# Python cache files
__pycache__/
*.pyc

# Secrets (API keys, passwords) - never commit these
.env

# Raw and processed data - stays on your machine, not in Git
data/

# SQLite database - generated by etl_v1.py
*.db

# Jupyter autosave files
.ipynb_checkpoints/

# Editor / OS clutter
.vscode/
.DS_Store
Thumbs.db
